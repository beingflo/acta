#!/usr/bin/env bash
#MISE description="Continuously send simulated readings for every data source to a running service"
#USAGE flag "--fast" help="Run with a 10x faster cadence"
#USAGE flag "--scale <scale>" help="Cadence multiplier (0.1 = 10x faster)"
#USAGE flag "--duration <seconds>" help="Stop after this many seconds (0 = forever)"
#USAGE flag "--seed <seed>" help="Seed the RNG for repeatable output"
#USAGE flag "--url <url>" help="Base URL of a running service" env="ACTA_URL"
#USAGE flag "--load" help="Load-test mode: ramp concurrency until throughput plateaus"
#USAGE flag "--load-batch <rows>" help="Rows per request in load mode"
#USAGE flag "--load-bodies <n>" help="Pre-generated request bodies in load mode"
#USAGE flag "--load-start <n>" help="Initial concurrency in load mode"
#USAGE flag "--load-max <n>" help="Maximum concurrency in load mode"
#USAGE flag "--load-step <factor>" help="Concurrency multiplier per ramp step"
#USAGE flag "--load-interval <seconds>" help="Control and report interval in load mode"
#USAGE flag "--load-plateau <n>" help="Non-improving intervals before holding the rate"
#USAGE flag "--load-error-threshold <rate>" help="Error rate that triggers backoff"
#USAGE flag "--load-timeout <seconds>" help="Per-request socket timeout in load mode"
set -euo pipefail

exec python3 tools/simulate_ingest.py "$@"
