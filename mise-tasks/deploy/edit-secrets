#!/usr/bin/env bash
#MISE description="Edit the encrypted deploy credentials (.deploy.secrets.enc) in place"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
# shellcheck source=/dev/null
source "$root/mise-tasks/lib/env.sh"

load_deploy_env

command -v sops >/dev/null || die "sops not found (brew install sops)"
[[ -f .deploy.secrets.enc ]] || die ".deploy.secrets.enc not found; is this the acta checkout?"

# sops decrypts to a temp file, opens $EDITOR on it and re-encrypts on save, so a
# plaintext copy never lands in the repo. The age key is passed to that one
# command instead of being exported, so it stays out of the environment of
# anything else sops starts, and nothing is written to disk. Quitting the editor
# without saving leaves the ciphertext untouched.
note "editing .deploy.secrets.enc"
SOPS_AGE_KEY="$(age_key)" sops --input-type dotenv --output-type dotenv .deploy.secrets.enc

note "installing the edited values: mise run deploy:secrets"
