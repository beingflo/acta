#!/usr/bin/env bash
#MISE description="Build, ship and deploy acta (run deploy:secrets first)"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
# shellcheck source=/dev/null
source "$root/mise-tasks/lib/env.sh"
load_deploy_env

host="${ACTA_HOST:-eos}"
s3_bucket="${ACTA_S3_BUCKET:-}"
tag="$(date +%Y%m%d-%H%M%S)-$(git rev-parse --short HEAD 2>/dev/null || echo nogit)"
image="localhost/acta:${tag}"

# `deploy` never holds a credential: it only checks that `deploy:secrets`
# installed them. The values themselves live in podman.
require_secret() {
    ssh "$host" "podman secret exists $1" >/dev/null 2>&1 \
        || die "podman secret $1 is missing; run: mise run deploy:secrets"
}

command -v podman >/dev/null || die "podman not found"
podman info >/dev/null 2>&1 || die "podman machine is not running"

require_secret acta-auth-ui-user
require_secret acta-auth-ui-password
require_secret acta-auth-sensor-user
require_secret acta-auth-sensor-password
if [[ -n "$s3_bucket" ]]; then
    require_secret acta-aws-key-id
    require_secret acta-aws-secret
fi

note "building ${image}"
podman build -t "$image" .

note "shipping ${image} to ${host}"
podman save "$image" | zstd -q -T0 | ssh "$host" 'zstd -q -d | podman load'
ssh "$host" "podman tag ${image} localhost/acta:current"

# Backup is on exactly when a bucket is configured.
if [[ -n "$s3_bucket" ]]; then
    ACTA_BACKUP=on
else
    ACTA_BACKUP=off
fi

# Every knob the service understands, with the value this deploy should use.
# A variable set in .deploy.env (or the environment) wins over the default
# here. Non-secret configuration is rendered straight into the quadlet, so the
# unit is the single source of truth and there is no second file to keep in
# sync. Credentials are podman secrets and never pass through this task.
tunables=(
    "TZ=UTC"
    "RUST_LOG=info"
    "ACTA_ADDR=0.0.0.0:8080"
    "ACTA_DATA_DIR=/data"
    "ACTA_UI_DIR=/usr/src/app/ui/dist"
    "ACTA_TILES_DIR=/usr/src/app/tiles"
    "ACTA_POOL_SIZE=4"
    "ACTA_MEMORY_LIMIT=512MB"
    "ACTA_THREADS=1"
    "ACTA_QUERY_TIMEOUT_MS=10000"
    "ACTA_MAX_RESPONSE_BYTES=8388608"
    "ACTA_FLUSH_INTERVAL_MS=10000"
    "ACTA_FLUSH_MAX_ROWS=50000"
    "ACTA_FLUSH_MAX_BYTES=67108864"
    "ACTA_INGEST_BACKLOG=64"
    "ACTA_INGEST_MAX_BODY_BYTES=16777216"
    "ACTA_INGEST_MAX_BATCH=10000"
    "ACTA_COMPACTION_INTERVAL_MS=60000"
    "ACTA_COMPACTION_GRACE_MS=30000"
    "ACTA_ROW_GROUP_SIZE=250000"
    "ACTA_TRASH_RETENTION_MS=86400000"
    "ACTA_TRASH_GC_INTERVAL_MS=600000"
    "ACTA_BACKUP=${ACTA_BACKUP}"
    "ACTA_BACKUP_MINUTE=3"
    "ACTA_S3_BUCKET="
    "ACTA_S3_REGION="
    "ACTA_S3_ENDPOINT="
    "ACTA_S3_PREFIX="
    "ACTA_S3_ALLOW_HTTP=off"
)

config=""
for entry in "${tunables[@]}"; do
    name="${entry%%=*}"
    value="${!name-}"
    [[ -n "$value" ]] || value="${entry#*=}"
    config+="Environment=${name}=${value}"$'\n'
done
config="${config%$'\n'}"

note "installing acta.container (${tag})"
if [[ -n "$s3_bucket" ]]; then
    sed "s|__TAG__|${tag}|g" acta.container
else
    sed -e "s|__TAG__|${tag}|g" -e '/type=env,target=AWS_/d' acta.container
fi | CONFIG="$config" awk '{ if ($0 == "__CONFIG__") print ENVIRON["CONFIG"]; else print }' \
  | ssh "$host" 'mkdir -p "$HOME/.config/containers/systemd" && cat > "$HOME/.config/containers/systemd/acta.container"'

# Drop the env file written by older deploys; it is no longer referenced.
ssh "$host" 'rm -f "$HOME/.config/acta/acta.env"; rmdir "$HOME/.config/acta" 2>/dev/null || true'

note "restarting"
ssh "$host" 'systemctl --user daemon-reload && systemctl --user restart acta'

# A container that dies while starting leaves the unit inactive after a clean
# exit, so nothing fails loudly. Check before reporting success.
if ! ssh "$host" 'podman ps --format "{{.Names}}" | grep -qx systemd-acta'; then
    ssh "$host" 'systemctl --user status acta --no-pager -n 20; echo; podman logs --tail 40 systemd-acta 2>&1' >&2 || true
    die "acta did not stay running after the restart"
fi

note "health check"
if ssh "$host" 'curl -sf --max-time 15 -o /dev/null http://127.0.0.1:8080/health'; then
    echo "ok"
else
    echo "WARN: /health is not ok (no co2 reading in the last 10 minutes, or the query failed)"
    ssh "$host" 'curl -s --max-time 15 http://127.0.0.1:8080/health; echo' || true
    echo "logs: ssh ${host} journalctl --user -u acta -n 50"
fi

note "pruning old images (keeping 5)"
ssh "$host" 'podman images --format "{{.Repository}}:{{.Tag}}" \
    | grep -E "^localhost/acta:" | grep -v ":current$" | sort \
    | head -n -5 | xargs -r podman rmi >/dev/null 2>&1 || true'

note "deployed ${image}"
