#!/usr/bin/env bash
#MISE description="Create/replace the podman secrets (auth passwords, S3 keys)"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
if [[ -f .env.deploy ]]; then
    set -a
    # shellcheck disable=SC1091
    source .env.deploy
    set +a
fi

host="${ACTA_HOST:-eos}"
s3_bucket="${ACTA_S3_BUCKET:-}"

die() { echo "error: $*" >&2; exit 1; }
note() { echo "==> $*"; }

create() {
    local name="$1" value="${2:-}"
    [[ -n "$value" ]] || die "$name value is empty"
    printf '%s' "$value" | ssh "$host" "podman secret create --replace $name - >/dev/null"
    echo "  ${name}"
}

note "installing podman secrets on ${host}"
create acta-auth-ui-password "${ACTA_AUTH_UI_PASSWORD:-}"
create acta-auth-sensor-password "${ACTA_AUTH_SENSOR_PASSWORD:-}"
if [[ -n "$s3_bucket" ]]; then
    create acta-aws-key-id "${AWS_ACCESS_KEY_ID:-}"
    create acta-aws-secret "${AWS_SECRET_ACCESS_KEY:-}"
else
    note "ACTA_S3_BUCKET is empty; backup is off, skipping S3 credentials"
fi

# A running container keeps the environment it started with, so a rotated
# secret only takes effect after a restart. Skip silently before the first
# deploy, when the unit does not exist yet.
if ssh "$host" 'systemctl --user cat acta >/dev/null 2>&1'; then
    note "restarting acta so the new secrets take effect"
    ssh "$host" 'systemctl --user restart acta'
else
    note "acta is not installed yet; run: mise run deploy"
fi
