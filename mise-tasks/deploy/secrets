#!/usr/bin/env bash
#MISE description="Create/replace the podman secrets (auth users and passwords, S3 keys)"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
# shellcheck source=/dev/null
source "$root/mise-tasks/lib/env.sh"

# The age key is fetched from 1Password here and nowhere else. `mise run deploy`
# never decrypts anything; it only checks that these secrets exist.
load_deploy_env
load_deploy_secrets

host="${ACTA_HOST:-eos}"
s3_bucket="${ACTA_S3_BUCKET:-}"

create() {
    local name="$1" var="$2" value="${3:-}"
    [[ -n "$value" ]] || die "$var is empty; add it to .deploy.secrets, re-encrypt it, and re-run"
    # The value travels on stdin, so it never appears in the remote argv.
    printf '%s' "$value" | ssh "$host" "podman secret create --replace $name - >/dev/null"
    echo "  ${name}"
}

note "installing podman secrets on ${host}"
create acta-auth-ui-user ACTA_AUTH_UI_USER "${ACTA_AUTH_UI_USER:-}"
create acta-auth-ui-password ACTA_AUTH_UI_PASSWORD "${ACTA_AUTH_UI_PASSWORD:-}"
create acta-auth-sensor-user ACTA_AUTH_SENSOR_USER "${ACTA_AUTH_SENSOR_USER:-}"
create acta-auth-sensor-password ACTA_AUTH_SENSOR_PASSWORD "${ACTA_AUTH_SENSOR_PASSWORD:-}"
if [[ -n "$s3_bucket" ]]; then
    create acta-aws-key-id AWS_ACCESS_KEY_ID "${AWS_ACCESS_KEY_ID:-}"
    create acta-aws-secret AWS_SECRET_ACCESS_KEY "${AWS_SECRET_ACCESS_KEY:-}"
else
    note "ACTA_S3_BUCKET is empty; backup is off, skipping S3 credentials"
fi

# A running container keeps the environment it started with, so a rotated
# secret only takes effect after a restart. Skip silently before the first
# deploy, when the unit does not exist yet.
if ssh "$host" 'systemctl --user cat acta >/dev/null 2>&1'; then
    note "restarting acta so the new secrets take effect"
    ssh "$host" 'systemctl --user restart acta'
else
    note "acta is not installed yet; run: mise run deploy"
fi
