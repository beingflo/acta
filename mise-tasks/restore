#!/usr/bin/env bash
#MISE description="Restore the S3 backup into a local directory (default data/)"
#USAGE arg "[dir]" help="target directory; the repo's data/ when omitted"
#USAGE flag "--force" help="overwrite files that already exist"
set -euo pipefail

invoked_from="$PWD"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
# shellcheck source=/dev/null
source "$root/mise-tasks/lib/env.sh"

dir="${usage_dir:-}"
if [[ -z "$dir" ]]; then
    # `mise run restore` with no argument means the directory this checkout serves,
    # whatever subdirectory the task was invoked from.
    dir="${root}/data"
else
    # A given directory resolves against where the task was invoked, not the repo
    # root the script needs to sit in for cargo. Restore merges, so a relative path
    # must mean what the caller saw.
    [[ "$dir" = /* ]] || dir="${invoked_from}/${dir}"
fi

# Same configuration and credentials the deployed service uses, decrypted through
# the shared helper: nothing is written to disk and no copy is left behind. Both
# helpers deliberately leave their values as plain shell variables so nothing
# leaks into a child process such as ssh; the restore binary is exactly such a
# child, so these have to be exported by hand.
load_deploy_env
load_deploy_secrets
for key in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY; do
    [[ -n "${!key:-}" ]] || die "${key} is missing from .deploy.secrets.enc"
done
[[ -n "${ACTA_S3_BUCKET:-}" ]] || die "ACTA_S3_BUCKET is empty; nothing to restore from"

# The archive is encrypted, and its age identity lives only in 1Password: there
# is deliberately no copy on the server, so a restore happens here and the data
# is then seeded to the host. Read the private half, hand it to the binary in its
# environment, and never write it to disk.
identity="$(backup_identity)"
[[ "$identity" == AGE-SECRET-KEY-1* ]] \
    || die "the private key of '$backup_item' in 1Password is not an age identity"
export ACTA_BACKUP_AGE_IDENTITY="$identity"
unset identity

export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY \
    ACTA_S3_BUCKET ACTA_S3_REGION ACTA_S3_ENDPOINT ACTA_S3_PREFIX ACTA_S3_ALLOW_HTTP

# Restore only adds and overwrites, so an existing directory keeps whatever the
# bucket does not carry. Say so rather than let it look like a clean rebuild.
if [[ -d "$dir" ]] && [[ -n "$(ls -A "$dir")" ]]; then
    note "${dir} is not empty; files absent from the bucket are left alone"
fi

args=(restore)
if [[ "${usage_force:-false}" == "true" ]]; then
    args+=(--force)
fi

# Release on purpose: it is the profile `service:dev` already builds, so this
# costs a link rather than a fresh debug tree, and the restored files are then
# served by the same binary.
note "restoring into ${dir}"
ACTA_DATA_DIR="$dir" cargo run --release --manifest-path service/Cargo.toml -- "${args[@]}"

note "serve it with: ACTA_DATA_DIR=${dir} mise run service:dev"
note "to replace the server's volume with it: mise run deploy:seed ${dir}"
