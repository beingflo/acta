[Unit]
Description=acta data collection service
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/acta:__TAG__
PublishPort=127.0.0.1:8080:8080
# Shared with marending.dev, whose exporter talks to the `acta` alias. The
# network unit is installed by `mise run deploy`; Caddy still reaches Acta on
# the loopback-published port above.
Network=acta-net.network
NetworkAlias=acta

# Data lives in a named volume; tiles are read-only and regenerated on the
# host. Non-secret configuration is rendered into the Environment= lines below
# by `mise run deploy`; credentials (both halves of each auth pair, plus the
# S3 keys) are podman secrets, so they never appear in the unit or the image.
Volume=acta-data:/data
Volume=%h/acta/tiles:/usr/src/app/tiles:ro,Z

# Run as the deploying user, and as nobody else: `keep-id` maps the host user to
# container uid 1000, which is the uid the image declares. Everything already on
# the volume was created by root-in-the-userns, i.e. by that same host user, so
# the switch renames nothing on disk and needs no chown. Without `keep-id`, uid
# 1000 would land on an unused subordinate id and the first flush would fail.
User=1000:1000
UserNS=keep-id:uid=1000,gid=1000
# It binds 8080 and reads two directories; it needs no capability at all, and
# nothing it execs may gain one.
NoNewPrivileges=true
DropCapability=all
__CONFIG__

Secret=acta-auth-ui-user,type=env,target=ACTA_AUTH_UI_USER
Secret=acta-auth-ui-password,type=env,target=ACTA_AUTH_UI_PASSWORD
Secret=acta-auth-sensor-user,type=env,target=ACTA_AUTH_SENSOR_USER
Secret=acta-auth-sensor-password,type=env,target=ACTA_AUTH_SENSOR_PASSWORD
# The optional restricted viewer (home dashboards only); the deploy drops these
# two lines when the secrets are not installed.
Secret=acta-auth-home-user,type=env,target=ACTA_AUTH_HOME_USER
Secret=acta-auth-home-password,type=env,target=ACTA_AUTH_HOME_PASSWORD
Secret=acta-aws-key-id,type=env,target=AWS_ACCESS_KEY_ID
Secret=acta-aws-secret,type=env,target=AWS_SECRET_ACCESS_KEY

[Service]
Restart=on-failure
RestartSec=5
# The service flushes the ingest buffer on SIGTERM; give it more than its own
# 15 s shutdown timeout.
TimeoutStopSec=30
MemoryMax=3G

[Install]
WantedBy=default.target
