[Unit]
Description=Shared Podman network for acta and marending.dev

[Network]
NetworkName=acta-net
# aardvark-dns answers container names on this network itself and forwards every
# other lookup to the upstream named here. Left unset, it forwards to the
# rootless network namespace's copy of the host resolver, which on a
# systemd-resolved host is the unreachable 127.0.0.53 stub — that is how the S3
# backup first failed. Pin a public IPv4 resolver, not the LAN router: the
# namespace's addresses and routes are a snapshot taken when it was created, so a
# LAN address is reachable only while that snapshot still matches the host (an
# uplink that appears later, such as a replugged USB adapter, leaves the
# namespace without a route to it). A public resolver needs nothing but a default
# route. IPv4 only: a hanging IPv6 upstream fails the same way.
DNS=1.1.1.1
