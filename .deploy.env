# Non-secret deploy configuration, committed and read by every
# `mise run deploy*` task. Uncomment a line to override the default shown in
# brackets. Everything set here is rendered into the systemd unit as an
# Environment= line, so `systemctl --user cat acta` always shows the effective
# configuration.
#
# Credentials never belong here. Both halves of each auth pair and the S3 keys
# live in the committed ciphertext `.deploy.secrets.enc`.

# --- deploy target ----------------------------------------------------------
# ssh host alias of the server [eos]
ACTA_HOST=eos

# --- logging ----------------------------------------------------------------
# RUST_LOG=info
# TZ=UTC

# --- server and paths (the container's own layout) --------------------------
# ACTA_ADDR=0.0.0.0:8080
# ACTA_DATA_DIR=/data
# ACTA_UI_DIR=/usr/src/app/ui/dist
# ACTA_TILES_DIR=/usr/src/app/tiles

# --- read path --------------------------------------------------------------
# DuckDB connections; each is an independent in-memory database. Two keeps a
# health probe or a second tab from queueing behind a chart, and it ran a whole
# dashboard faster than four on the M1. [4]
ACTA_POOL_SIZE=2
# DuckDB memory limit PER connection, so the worst case is POOL_SIZE times
# this. The unit caps the container at 3G. [512MB]
# ACTA_MEMORY_LIMIT=512MB
ACTA_THREADS=4
# ACTA_QUERY_TIMEOUT_MS=10000
# ACTA_MAX_RESPONSE_BYTES=8388608
# How long the epaper panel waits between pictures; it is sent to the device in
# the X-Refresh-Seconds header, so this is the one knob that changes the
# interval without reflashing the panel. [120]
# ACTA_DASHBOARD_REFRESH_SECONDS=120

# --- write path -------------------------------------------------------------
# ACTA_FLUSH_INTERVAL_MS=10000
# ACTA_FLUSH_MAX_ROWS=50000
# ACTA_FLUSH_MAX_BYTES=67108864
# ACTA_INGEST_BACKLOG=64
# ACTA_INGEST_MAX_BODY_BYTES=16777216
# ACTA_INGEST_MAX_BATCH=10000

# --- compaction -------------------------------------------------------------
# ACTA_COMPACTION_INTERVAL_MS=60000
# ACTA_COMPACTION_GRACE_MS=30000
# A closed month is a few hundred thousand rows; this keeps it in one row group.
# Parquet fixes a file's VARIANT shredding schema from its first row group, and
# only a group that holds every source gets every payload into typed columns.
ACTA_ROW_GROUP_SIZE=2000000
# ACTA_TRASH_RETENTION_MS=86400000
# ACTA_TRASH_GC_INTERVAL_MS=600000

# --- S3 backup --------------------------------------------------------------
# The backup speaks the S3 protocol, not AWS specifically: it runs against
# Backblaze B2. A B2 bucket page shows a single URL, `https://s3.<region>.backblazeb2.com`,
# and that is all there is to set: the URL is the endpoint, its region label is
# read off it, and the prefix stays empty unless objects should nest under one.
# Copy the URL with its scheme: ACTA_S3_ENDPOINT must start with https:// (or with
# http:// when ACTA_S3_ALLOW_HTTP is on), otherwise the service refuses to start.
# ACTA_BACKUP is derived from this: it is on exactly when ACTA_S3_BUCKET is
# set, so leave the bucket empty to run without backups.
ACTA_S3_BUCKET=eos-backup
ACTA_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# Only for a provider whose endpoint does not encode the region; on B2 an
# explicit value here would have to match the endpoint exactly.
# ACTA_S3_REGION=
ACTA_S3_PREFIX=acta
# One pass at startup, then hourly at this minute past the hour. Three leaves the
# compaction pass that closes the previous hour time to write its file. [3]
# ACTA_BACKUP_MINUTE=3
# ACTA_S3_ALLOW_HTTP=off
#
# The B2 application key goes into .deploy.secrets as AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY: those are the variable names the S3 SDK reads,
# whatever the provider.
